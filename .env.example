# ─── Database ────────────────────────────────────────────────────────────────
# In production, Cloudflare Pages binds D1 directly (DB binding in the dashboard).
# The REST fallback below is only needed for local development without wrangler.
D1_REST_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/d1/database/your-database-id
D1_REST_TOKEN=your-cloudflare-api-token

# Set to any non-empty value to skip automatic schema creation at boot.
# SKIP_SCHEMA_ENSURE=1

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED. Used to sign session tokens (HMAC-SHA256) and hash verification
# codes. Generate one with: openssl rand -hex 32
AUTH_SECRET=your-random-64-char-hex-secret

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Used for signup verification and password reset codes.
# Without a key, verification codes are printed to the server logs (dev only).
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="FlowDesk <onboarding@resend.dev>"

# ─── Cloudflare bindings (configured in the Pages dashboard, not here) ───────
# DB   → D1 database
# R2   → R2 bucket (file storage)
