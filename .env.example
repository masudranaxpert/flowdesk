D1_REST_URL=https://d1-rest.<your-worker>.workers.dev
D1_REST_TOKEN="replace-with-your-d1-rest-token"
AUTH_SECRET="replace-with-a-long-random-secret"

# Gmail email verification
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=yourgmail@gmail.com

# Optional custom SMTP override
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
